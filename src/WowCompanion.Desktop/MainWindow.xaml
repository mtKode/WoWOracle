<ui:FluentWindow x:Class="WowCompanion.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:WowCompanion.Desktop"
                 Title="WoW Oracle"
                 Icon="pack://application:,,,/Assets/wow-oracle.ico"
                 Width="1130" Height="1000" MinWidth="760" MinHeight="560"
                 FontFamily="{DynamicResource Serif}"
                 Topmost="{Binding AlwaysOnTop}"
                 WindowStyle="None"
                 AllowsTransparency="True"
                 WindowBackdropType="None"
                 ResizeMode="CanResize"
                 Background="Transparent">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Items" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Recipes" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Craft" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Spells" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Talents" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Gear" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Calc" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Loot" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Notes" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Journal" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Map" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveNoteCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- Palette: dark brown base, aged-gold edges, parchment text (Armory-like). -->
        <SolidColorBrush x:Key="Bg" Color="#150C07" />
        <SolidColorBrush x:Key="Panel" Color="#211A13" />
        <SolidColorBrush x:Key="PanelRaised" Color="#2C2218" />
        <SolidColorBrush x:Key="Hover" Color="#3A2B1B" />
        <SolidColorBrush x:Key="Edge" Color="#6B5430" />
        <SolidColorBrush x:Key="Gold" Color="#FFD100" />
        <SolidColorBrush x:Key="Parchment" Color="#EADBB8" />
        <SolidColorBrush x:Key="Dim" Color="#A8977A" />
        <SolidColorBrush x:Key="Divider" Color="#33281A" />
        <SolidColorBrush x:Key="Green" Color="#1EFF00" />
        <SolidColorBrush x:Key="SetGrey" Color="#9D9D9D" />
        <FontFamily x:Key="Serif">Palatino Linotype, Georgia, Times New Roman</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Window backdrop: dark leather panel, stretched so its worn edges sit on the window edges. -->
        <ImageBrush x:Key="Backdrop" ImageSource="pack://application:,,,/Assets/background.jpg" Stretch="Fill" />

        <!-- Text boxes. The placeholder text comes from Tag. -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Edge}" />
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                           Padding="{TemplateBinding Padding}" FontStyle="Italic"
                                           Foreground="{StaticResource Dim}" IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big search box's text part: no frame of its own (the surrounding SearchFrame draws it). -->
        <Style x:Key="BareSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}"
                                       FontStyle="Italic" Foreground="{StaticResource Dim}" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- List rows (dropdown and recipe list). -->
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recipe rows: same as list rows plus a divider line. -->
        <Style x:Key="RecipeItem" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                <ContentPresenter />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Picker rows (enchants): plain rows, the highlighted one (arrow keys) gets a gold edge. -->
        <Style x:Key="PickItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="3" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left rail entries. Selection is real list selection, so the state always shows. -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="14,13" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource Parchment}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Side tabs: book tabs that stick out of the left edge of the frame, each with a game icon (Tag). -->
        <Style x:Key="SideTab" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,-1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tab" Width="48" Height="48" BorderThickness="1,1,0,1"
                                CornerRadius="{Binding (local:SideTabs.Corner), RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" Margin="0,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="200" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <Border x:Name="Frame" Width="34" Height="34" BorderThickness="1" CornerRadius="3"
                                    BorderBrush="#2A2018" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <local:GameIcon x:Name="Icon" IconName="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                Size="medium" Opacity="0.7" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Parchment}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                                <Setter TargetName="Tab" Property="Width" Value="54" />
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Drawn above its neighbours, so its gold border isn't covered by the tab below. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "View on map": a small map-pin button next to a place. -->
        <Style x:Key="MapButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="View on map" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Width="26" Height="22" CornerRadius="3" Background="#2A2116"
                                BorderBrush="#9C7A3C" BorderThickness="1">
                            <TextBlock x:Name="Glyph" Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#FFE08A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profession chips. -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Padding="10,4" Background="Transparent"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square frame around a game icon. -->
        <Style x:Key="IconFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Body text line that disappears when it is empty. -->
        <Style x:Key="Line" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Read-only text boxes: look like text, but can be selected and copied. -->
        <Style x:Key="CopyText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Edge}" />
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- A Decorator host (not a ScrollViewer) so the mouse wheel still scrolls the page behind it. -->
                        <Decorator x:Name="PART_ContentHost" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyLine" TargetType="TextBox" BasedOn="{StaticResource CopyText}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Multi-line box (note text): same look, text starts at the top. -->
        <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Stretch" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}"
                                           FontStyle="Italic" Foreground="{StaticResource Dim}" IsHitTestVisible="False"
                                           Visibility="Collapsed" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An item line you can click (loot lists, upgrade finder): highlights on hover. -->
        <Style x:Key="ClickRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                            <TextBlock Text="Pin on top" FontSize="12" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Hover card shell: no chrome of its own, the card draws everything. -->
        <Style x:Key="CardToolTip" TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Talent hover card, game tooltip style. DataContext = TalentDetail. -->
        <DataTemplate x:Key="TalentCard">
            <Border MaxWidth="340" Padding="14,11" Background="{StaticResource PanelRaised}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                <StackPanel TextElement.FontFamily="{DynamicResource Serif}">
                    <TextBlock Text="{Binding Name}" FontSize="17" Foreground="{StaticResource Parchment}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RankLine}" FontSize="13" Foreground="{StaticResource Dim}" />
                    <ItemsControl ItemsSource="{Binding Requirements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="#FF4040" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Current}" FontSize="13" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding NextLabel}" FontSize="13" Foreground="{StaticResource Parchment}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Next}" FontSize="13" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Item hover card, game tooltip style. DataContext = ItemView. -->
        <DataTemplate x:Key="ItemCard">
            <Border MaxWidth="360" Padding="14,11" Background="{StaticResource PanelRaised}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                <StackPanel TextElement.FontFamily="{DynamicResource Serif}">
                    <TextBlock Text="{Binding Name}" FontSize="17" Foreground="{Binding NameBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LevelLine}" Style="{StaticResource Line}" FontSize="13" Foreground="{StaticResource Gold}" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding BindingLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding UniqueLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TypeLine}" FontSize="13" Foreground="{StaticResource Parchment}" Margin="16,1,0,0" />
                        <TextBlock Text="{Binding SlotLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedLine}" FontSize="13" Foreground="{StaticResource Parchment}" Margin="16,1,0,0" />
                        <TextBlock Text="{Binding DamageLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding DpsLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding ArmorLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    <ItemsControl ItemsSource="{Binding StatLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ClassLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding RequirementLine}" Style="{StaticResource Line}" FontSize="13" Margin="0,1,0,0" />
                    <ItemsControl ItemsSource="{Binding EffectLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Line}" FontSize="13" Foreground="{StaticResource Green}" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SetTitle}" Style="{StaticResource Line}" FontSize="13" Foreground="{StaticResource Gold}" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding SetLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" TextWrapping="Wrap" Margin="8,1,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One talent tree: art, prerequisite arrows and the talent squares. DataContext = TalentTreeView. -->
        <DataTemplate x:Key="TalentTreeBody">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3" Padding="10" ClipToBounds="True">
                          <Grid>
                            <!-- Tree art from Wowhead, or a faint spec icon when there is none. -->
                            <!-- A Rectangle, not an Image: it never asks for space, so big art can't stretch the tree. -->
                            <Rectangle Opacity="0.55" Margin="-10"
                                       Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Source="{Binding Art}" Stretch="Uniform" Opacity="0.08" Width="300"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding HasWatermark, Converter={StaticResource BoolToVis}}" />
                            <Grid>
                              <Grid>
                                <!-- Prerequisite arrows, behind the squares. -->
                                <ItemsControl ItemsSource="{Binding Arrows}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Path x:Name="ArrowLine" Data="{Binding Line}" Stroke="{StaticResource Edge}"
                                                      StrokeThickness="3" />
                                                <Path x:Name="ArrowHead" Data="{Binding Head}" Fill="{StaticResource Edge}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                    <Setter TargetName="ArrowLine" Property="Stroke" Value="{StaticResource Gold}" />
                                                    <Setter TargetName="ArrowHead" Property="Fill" Value="{StaticResource Gold}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="96" />
                                                    <RowDefinition Height="96" />
                                                    <RowDefinition Height="96" />
                                                    <RowDefinition Height="96" />
                                                    <RowDefinition Height="96" />
                                                    <RowDefinition Height="96" />
                                                    <RowDefinition Height="96" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Grid.Row" Value="{Binding Tier}" />
                                            <Setter Property="Grid.Column" Value="{Binding Column}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Cell" Width="84" Height="84" Margin="6" CornerRadius="4"
                                                    Background="{StaticResource PanelRaised}" BorderThickness="2"
                                                    BorderBrush="{StaticResource Divider}" Cursor="Hand"
                                                    MouseEnter="OnTalentMouseEnter" MouseLeave="OnTalentMouseLeave"
                                                    MouseDown="OnTalentMouseDown">
                                                <Grid>
                                                    <Border Style="{StaticResource IconFrame}" Width="42" Height="42"
                                                            VerticalAlignment="Top" Margin="0,5,0,0">
                                                        <local:GameIcon FileId="{Binding IconId}" Size="large" />
                                                    </Border>
                                                    <TextBlock x:Name="CellName" Text="{Binding Name}" FontSize="10"
                                                               TextWrapping="Wrap" TextAlignment="Center" Margin="2,48,2,0"
                                                               VerticalAlignment="Top" MaxHeight="28" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Dim}" />
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                                            Padding="4,0" CornerRadius="2" Background="{StaticResource Bg}">
                                                        <TextBlock x:Name="CellRank" Text="{Binding RankText}" FontSize="11.5"
                                                                   Foreground="{StaticResource Dim}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Locked">
                                                    <Setter TargetName="Cell" Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Available">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Green}" />
                                                    <Setter TargetName="CellName" Property="Foreground" Value="{StaticResource Parchment}" />
                                                    <Setter TargetName="CellRank" Property="Foreground" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Partial">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Green}" />
                                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource Hover}" />
                                                    <Setter TargetName="CellName" Property="Foreground" Value="{StaticResource Parchment}" />
                                                    <Setter TargetName="CellRank" Property="Foreground" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Max">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource Hover}" />
                                                    <Setter TargetName="CellName" Property="Foreground" Value="{StaticResource Gold}" />
                                                    <Setter TargetName="CellRank" Property="Foreground" Value="{StaticResource Gold}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Grid>
                            </Grid>
                          </Grid>
                        </Border>
        </DataTemplate>

        <!-- Talent description; DataContext = the main view model. -->
        <DataTemplate x:Key="TalentDetailPanel">
            <Border Padding="16,14" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <TextBlock Text="Hover a talent to read it. Left click adds a point, right click removes one."
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Dim}"
                               Visibility="{Binding NoTalentDetail, Converter={StaticResource BoolToVis}}" />
                    <StackPanel DataContext="{Binding TalentDetail}"
                                Visibility="{Binding DataContext.HasTalentDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource CopyText}" Text="{Binding Name, Mode=OneWay}" FontSize="18" />
                            <TextBox Style="{StaticResource CopyText}" Text="{Binding RankLine, Mode=OneWay}" Foreground="{StaticResource Dim}"
                                     VerticalAlignment="Bottom" Margin="12,0,0,2" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Requirements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding Mode=OneWay}" Foreground="#FF4040" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding Current, Mode=OneWay}"
                                 Foreground="{StaticResource Gold}" Margin="0,6,0,0" />
                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding NextLabel, Mode=OneWay}" Margin="0,8,0,0" />
                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding Next, Mode=OneWay}"
                                 Foreground="{StaticResource Gold}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tree header in the all-trees view. -->
        <DataTemplate x:Key="TreeHeader">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                <Border Style="{StaticResource IconFrame}" Width="24" Height="24" Margin="0,0,8,0" CornerRadius="2">
                    <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                </Border>
                <TextBlock Text="{Binding Header}" FontSize="16" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <!-- A quest reward on the quest card: icon and name; click opens it, hover shows its card. -->
        <DataTemplate x:Key="QuestRewardTemplate">
            <Border Style="{StaticResource ClickRow}" MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave" HorizontalAlignment="Left"
                    MinWidth="300">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenQuestRewardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="32" Height="32" Margin="0,0,10,0">
                        <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>

    </ui:FluentWindow.Resources>

    <!-- The window itself is transparent: the side tabs stick out to the left of the framed app. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="SideTabs" Grid.Column="0" SelectedIndex="{Binding ViewIndex}" Margin="0,92,0,0" VerticalAlignment="Top"
                 Background="Transparent" BorderThickness="0" Padding="0" Panel.ZIndex="1" Focusable="False"
                 ItemContainerStyle="{StaticResource SideTab}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBoxItem Tag="inv_misc_bag_08" ToolTip="Items (Ctrl+1)" local:SideTabs.Corner="7,0,0,0" />
            <ListBoxItem Tag="inv_scroll_03" ToolTip="Recipes (Ctrl+2)" />
            <ListBoxItem Tag="trade_blacksmithing" ToolTip="Crafting (Ctrl+3)" />
            <ListBoxItem Tag="inv_misc_book_09" ToolTip="Spells (Ctrl+4)" />
            <ListBoxItem Tag="ability_marksmanship" ToolTip="Talents (Ctrl+5)" />
            <ListBoxItem Tag="inv_chest_plate06" ToolTip="Gear (Ctrl+6)" />
            <ListBoxItem Tag="inv_gizmo_01" ToolTip="Calculator (Ctrl+7)" />
            <ListBoxItem Tag="inv_box_02" ToolTip="Loot (Ctrl+8)" />
            <ListBoxItem Tag="inv_misc_note_01" ToolTip="Notes (Ctrl+9)" />
            <ListBoxItem Tag="inv_misc_book_11" ToolTip="Journal (Ctrl+0)" />
            <ListBoxItem Tag="inv_misc_map_01" ToolTip="Map (Ctrl+M)" local:SideTabs.Corner="0,0,0,7" />
        </ListBox>

        <Border x:Name="MainFrame" Grid.Column="1" Background="{StaticResource Backdrop}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WoW Oracle" Foreground="{StaticResource Parchment}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wow-oracle-icon.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Item search is global: the dropdown floats over whichever view is open. -->
        <Grid Grid.Row="1" Margin="14,8,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Setup banner (MainViewModel.Setup): WoW not found, addon missing or outdated. -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,7" CornerRadius="3" BorderThickness="1"
                    Background="#2A1F12" BorderBrush="{StaticResource Gold}"
                    Visibility="{Binding SetupBannerVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DismissSetupCommand}" ToolTip="Hide (the Addon button at the bottom brings it back)"
                            Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="X" Text="&#x2715;" FontSize="13" Foreground="{StaticResource Dim}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="X" Property="Foreground" Value="{StaticResource Gold}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="{Binding SetupButtonText}" Style="{StaticResource PillButton}"
                            Command="{Binding SetupMainCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource PillButton}"
                            Command="{Binding BrowseWowCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Pick the World of Warcraft folder yourself"
                            Visibility="{Binding SetupShowBrowse, Converter={StaticResource BoolToVis}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SetupBannerText}" FontSize="13" Foreground="{StaticResource Parchment}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SetupClients}" Margin="0,5,0,0"
                                      Visibility="{Binding HasSetupClients, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                            CornerRadius="3" Padding="8,2" Margin="0,0,6,0">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Client, Mode=OneWay}" Foreground="{StaticResource Parchment}" /><Run Text="   " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{Binding StateBrush, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Search frame: filter chips (Discord style) then the text. The frame lights up while typing. -->
            <Border x:Name="SearchFrame" Grid.Row="1" Background="{StaticResource Panel}" BorderThickness="1" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding SearchChips}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="FilterPill" Background="{StaticResource Hover}" BorderBrush="{Binding Brush}" BorderThickness="1"
                                        CornerRadius="3" Padding="7,2,3,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Cursor="Hand" MouseLeftButtonDown="OnChipMouseDown"
                                        ToolTip="Click to pick, double click to edit. Keyboard: ← at the start of the text, then ← → Del Enter">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Key}" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" FontSize="13" Foreground="{Binding Brush}" Margin="3,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="×" Cursor="Hand" Margin="5,0,0,0" Padding="3,0" FontSize="13"
                                                Foreground="{StaticResource Dim}" Background="Transparent" BorderThickness="0"
                                                ToolTip="Remove filter" Focusable="False"
                                                Command="{Binding DataContext.RemoveChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock x:Name="X" Text="×" FontSize="14" Foreground="{StaticResource Dim}" Padding="2,0" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="X" Property="Foreground" Value="{StaticResource Gold}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Picked with the arrow keys: lit up in gold. -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="FilterPill" Property="Background" Value="#4DFFD100" />
                                        <Setter TargetName="FilterPill" Property="BorderBrush" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="HelpButton" DockPanel.Dock="Right" Click="OnHelpClick" Cursor="Hand" Focusable="False"
                            ToolTip="All search filters and shortcuts" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Ring" Width="24" Height="24" CornerRadius="12" BorderThickness="1"
                                        BorderBrush="{StaticResource Edge}" Background="Transparent">
                                    <TextBlock x:Name="Mark" Text="?" FontSize="14" Foreground="{StaticResource Dim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Gold}" />
                                        <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Gold}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBox x:Name="SearchBox" Style="{StaticResource BareSearchTextBox}"
                             Tag="{Binding SearchPlaceholder}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Border>

            <Popup x:Name="ResultsPopup" IsOpen="{Binding IsDropdownOpen}"
                   PlacementTarget="{Binding ElementName=SearchFrame}" Placement="Bottom" VerticalOffset="4"
                   StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="{Binding ActualWidth, ElementName=SearchFrame}" MaxHeight="440"
                        Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Gold}"
                        BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Line}" Margin="14,12"
                                   Foreground="{StaticResource Dim}" />
                        <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                                 SelectedIndex="{Binding HighlightIndex}"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0,3"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="430">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="34" Height="34" Margin="0,0,10,0">
                                            <local:GameIcon FileId="{Binding IconId}" IconName="{Binding IconName}" Size="medium" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                                       FontFamily="{DynamicResource Serif}" FontSize="15"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12"
                                                       Foreground="{StaticResource Dim}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Shortcut reminder -->
                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="12,6">
                          <StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap">
                                <Run Text="Enter" Foreground="{StaticResource Gold}" /><Run Text=" open   " />
                                <Run Text="Shift+Enter / Shift+click" Foreground="{StaticResource Gold}" /><Run Text=" add to gear set   " />
                                <Run Text="Ctrl+Enter / Ctrl+click" Foreground="{StaticResource Gold}" /><Run Text=" add recipe to craft list   " />
                                <Run Text="Esc" Foreground="{StaticResource Gold}" /><Run Text=" close" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource Dim}" Margin="0,3,0,0">
                                <Run Text="All filters (stat:, slot:, type:, q:, lvl:, class:) under the" /> <Run Text="?" Foreground="{StaticResource Gold}" /> <Run Text="button in the search box." />
                            </TextBlock>
                          </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Filter reference card, opened by the ? button -->
            <Popup x:Name="FilterHelp" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom"
                   HorizontalOffset="-520" VerticalOffset="6" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="560" Padding="18,14" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Gold}"
                        BorderThickness="1" CornerRadius="3">
                    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                        <StackPanel TextElement.FontFamily="{DynamicResource Serif}" TextElement.FontSize="13" Margin="0,0,10,0">
                            <TextBlock Text="Search filters" FontSize="18" Foreground="{StaticResource Parchment}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,2,0,0"
                                       Text="Plain words search item names. Filters go anywhere, all must match. A filter becomes a chip when you type a space after it; Backspace at the start of the text edits the last chip. ← at the start of the text walks onto the chips: ← → pick one, Del / Backspace remove it, Enter edits it, End or typing goes back to the text. Click a chip to pick it, double click to edit. While you type a filter the list suggests how to finish it (st → stat:, stat:cr → stat:crit, from:rag → Ragnaros): Tab takes it." />
                            <CheckBox IsChecked="{Binding HideSodItems}" Margin="0,10,0,0" Foreground="{StaticResource Parchment}" FontSize="13"
                                      Content="Hide Season of Discovery leftovers and test items"
                                      ToolTip="SoD items are in Forever's game data but not in the game. Applies to search, recipes, upgrades and the profession planner; items you're seen to use in game always show." />
                                <TextBlock Text="Stats  (results sort by the stat, highest first)" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:str  stat:agi  stat:sta  stat:int  stat:spi" Foreground="{StaticResource Gold}" /><Run Text="   attributes; also stat:hp  stat:mana" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:sp  stat:heal  stat:crit  stat:hit" Foreground="{StaticResource Gold}" /><Run Text="   spell power, healing, crit, hit" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:ap  stat:rap  stat:mp5  stat:haste  stat:pen" Foreground="{StaticResource Gold}" /><Run Text="   attack power, ranged AP, mana per 5, haste, spell penetration" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:armor  stat:def  stat:dodge  stat:parry  stat:block" Foreground="{StaticResource Gold}" /><Run Text="   defense" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:fire  stat:frost  stat:shadow  stat:nature  stat:arcane  stat:holy" Foreground="{StaticResource Gold}" /><Run Text="   school spell power" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:fr  stat:frr  stat:sr  stat:nr  stat:ar" Foreground="{StaticResource Gold}" /><Run Text="   fire, frost, shadow, nature, arcane resistance" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="stat:str stat:sta   or   stat:str,sta" Foreground="{StaticResource Gold}" /><Run Text="   several: the item needs all of them" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock Text="Slots  (slot:x, or the bare word next to another filter)" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Armor" Foreground="{StaticResource Gold}" /><Run Text="   head  neck  shoulder  back / cloak  chest  shirt  tabard  wrist  hands  waist  legs  feet  ring  trinket" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Weapon groups" Foreground="{StaticResource Gold}" /><Run Text="   weapon  melee  1h  2h  mainhand / mh  offhand / oh  shield  held  ranged  relic" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Weapon types" Foreground="{StaticResource Gold}" /><Run Text="   slot: also takes sword  dagger  bow ... (same as type:)" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock Text="Types" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="type:plate" Foreground="{StaticResource Gold}" /><Run Text="   cloth  leather  mail  plate  shield" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="type:sword" Foreground="{StaticResource Gold}" /><Run Text="   axe  mace  sword  dagger  staff  polearm  fist  bow  gun  crossbow  wand  thrown  fishing" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="type:recipe" Foreground="{StaticResource Gold}" /><Run Text="   weapon  armor  consumable  recipe  reagent  tradegoods  quest  container" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock Text="Rarity, levels, class" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="q:epic" Foreground="{StaticResource Gold}" /><Run Text="   poor  common  uncommon  rare  epic  legendary  (or grey white green blue purple orange)" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="q:rare+" Foreground="{StaticResource Gold}" /><Run Text="   that rarity or better" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="lvl:60" Foreground="{StaticResource Gold}" /><Run Text="   required level; also lvl:50-60  lvl:58+  lvl:&lt;40" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="ilvl:60+" Foreground="{StaticResource Gold}" /><Run Text="   item level, same forms as lvl:" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="class:mage" Foreground="{StaticResource Gold}" /><Run Text="   items that class can use: warrior paladin hunter rogue priest shaman mage warlock druid" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="quest:defias" Foreground="{StaticResource Gold}" /><Run Text="   rewards of quests with that in the name; several words in quotes: quest:&quot;the defias brotherhood&quot;" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="from:ragnaros" Foreground="{StaticResource Gold}" /><Run Text="   dropped or sold by an NPC (or found in a chest) with that in the name" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="&quot;chest&quot;" Foreground="{StaticResource Gold}" /><Run Text="   a word in quotes always searches names, never a slot" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock Text="Examples" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="neck stat:str q:rare+" Foreground="{StaticResource Gold}" /><Run Text="   best Strength necklaces, rare or better" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="slot:2h stat:ap lvl:50-60" Foreground="{StaticResource Gold}" /><Run Text="   two-handers with attack power for levels 50 to 60" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="trinket stat:sp class:mage" Foreground="{StaticResource Gold}" /><Run Text="   spell power trinkets a mage can use" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock Text="Keys" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,2" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Enter" Foreground="{StaticResource Gold}" /><Run Text="   open the highlighted item" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Shift+Enter / Shift+click" Foreground="{StaticResource Gold}" /><Run Text="   add it to the gear set (Gear page)" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Ctrl+Enter / Ctrl+click" Foreground="{StaticResource Gold}" /><Run Text="   add its recipe to the craft list" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Esc" Foreground="{StaticResource Gold}" /><Run Text="   close the list; again to clear the search" Foreground="{StaticResource Parchment}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="/" Foreground="{StaticResource Gold}" /><Run Text="   jump to the search from anywhere;  Ctrl+Shift+_ shows or hides the app" Foreground="{StaticResource Parchment}" /></TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Items view ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsItemsView, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Search for an item or a quest to see its details." FontFamily="{DynamicResource Serif}"
                               FontSize="18" Foreground="{StaticResource Dim}" TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Tab or the arrow keys move through the results. Enter opens one, Shift+Enter adds it to your gear set, Ctrl+Enter queues its recipe, Esc closes the list, / starts a new search."
                               FontSize="12" Foreground="{StaticResource Dim}" Opacity="0.8" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Quest card (a quest chosen in the search): who, where, its chain and rewards. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasQuestSelection, Converter={StaticResource BoolToVis}}">
                    <Border DataContext="{Binding SelectedQuest}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3" Padding="18,16" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Serif}" FontSize="22" Foreground="{StaticResource Gold}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LevelLine}" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />

                            <DockPanel Margin="0,12,0,0" Visibility="{Binding HasGiver, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Left" Style="{StaticResource MapButton}" Margin="0,0,8,0"
                                        Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding MapText}" />
                                <TextBlock FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="Given by " Foreground="{StaticResource Dim}" /><Run Text="{Binding Giver, Mode=OneWay}" Foreground="{StaticResource Parchment}" /><Run Text="   " /><Run Text="{Binding Place, Mode=OneWay}" Foreground="#8CC4F0" />
                                </TextBlock>
                            </DockPanel>

                            <TextBlock Text="{Binding Objectives}" FontSize="13" FontStyle="Italic" Foreground="{StaticResource Parchment}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.9"
                                       Visibility="{Binding HasObjectives, Converter={StaticResource BoolToVis}}" />

                            <!-- The full quest text, folded away -->
                            <Button Content="Quest text" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,2"
                                    ToolTip="What the quest giver tells you"
                                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ToggleQuestTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="3"
                                    Padding="12,10" Margin="0,6,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.QuestTextOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Parchment}" TextWrapping="Wrap"
                                           LineHeight="19" />
                            </Border>

                            <!-- Chain -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasChain, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ChainTitle}" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Chain}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Cursor="Hand" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Row" Background="Transparent" Padding="4,2" CornerRadius="2">
                                                            <TextBlock FontSize="13">
                                                                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{Binding TitleBrush, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Meta, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" />
                                                            </TextBlock>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Rewards -->
                            <TextBlock Text="You will receive:" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,14,0,4"
                                       Visibility="{Binding HasRewards, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Rewards}" ItemTemplate="{DynamicResource QuestRewardTemplate}"
                                          Visibility="{Binding HasRewards, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Choose one of:" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,14,0,4"
                                       Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{DynamicResource QuestRewardTemplate}"
                                          Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid DataContext="{Binding Selected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <!-- Tooltip-style card -->
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="18,16">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="58" Height="58"
                                                Margin="0,0,14,0" BorderBrush="{Binding NameBrush}">
                                            <local:GameIcon FileId="{Binding IconId}" Size="large" />
                                        </Border>
                                        <TextBox Style="{StaticResource CopyText}" Text="{Binding Name, Mode=OneWay}" VerticalAlignment="Center"
                                                 Foreground="{Binding NameBrush}" FontSize="24" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding LevelLine, Mode=OneWay}"
                                             Foreground="{StaticResource Gold}" />
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding BindingLine, Mode=OneWay}" />
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding UniqueLine, Mode=OneWay}" />
                                    <Grid>
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding SlotLine, Mode=OneWay}" HorizontalAlignment="Left" />
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding TypeLine, Mode=OneWay}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding KindLine, Mode=OneWay}" />
                                    <Grid>
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding DamageLine, Mode=OneWay}" HorizontalAlignment="Left" />
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding SpeedLine, Mode=OneWay}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding DpsLine, Mode=OneWay}" />
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding ArmorLine, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{Binding StatLines}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource CopyLine}" Text="{Binding Mode=OneWay}" Margin="0,1,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding ClassLine, Mode=OneWay}" Margin="0,8,0,0" />
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding RequirementLine, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{Binding EffectLines}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource CopyLine}" Text="{Binding Mode=OneWay}"
                                                         Foreground="{StaticResource Green}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding SetTitle, Mode=OneWay}"
                                                 Foreground="{StaticResource Gold}" />
                                        <ItemsControl ItemsSource="{Binding SetLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding Text, Mode=OneWay}"
                                                             Foreground="{Binding Brush}" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding Description, Mode=OneWay}"
                                             Foreground="{StaticResource Gold}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Where it comes from -->
                            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                                BorderThickness="1" CornerRadius="3" Padding="18,14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Heading}" FontFamily="{DynamicResource Serif}"
                                                           FontSize="16" Foreground="{StaticResource Gold}" />
                                                <!-- Long lists (hundreds of drops) scroll inside the card and only build what's visible. -->
                                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0" MaxHeight="280"
                                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                                    <ItemsControl.Template>
                                                        <ControlTemplate TargetType="ItemsControl">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                                                <ItemsPresenter />
                                                            </ScrollViewer>
                                                        </ControlTemplate>
                                                    </ItemsControl.Template>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Entry: bright first line, dim details below, a gap before the next entry -->
                                                            <StackPanel Margin="0,0,0,9">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChanceText}" FontSize="13"
                                                                               Foreground="{StaticResource Green}" Margin="10,0,4,0" VerticalAlignment="Center"
                                                                               ToolTip="Drop chance (Classic data)" />
                                                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding Title, Mode=OneWay}"
                                                                             Foreground="{Binding TitleBrush}" />
                                                                </DockPanel>
                                                                <TextBox Style="{StaticResource CopyLine}" Text="{Binding Detail, Mode=OneWay}"
                                                                         Foreground="{StaticResource Dim}" FontSize="13" Margin="12,1,0,0" />
                                                                <DockPanel Margin="12,1,0,0">
                                                                    <Button DockPanel.Dock="Left" Style="{StaticResource MapButton}" Margin="0,0,6,0"
                                                                            Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                                                                            Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding Place, Mode=OneWay}"
                                                                             Foreground="#8CC4F0" FontSize="13" />
                                                                </DockPanel>
                                                                <!-- Skill-up bands in their colours (orange always +1, yellow usually, green sometimes, grey never) -->
                                                                <ItemsControl ItemsSource="{Binding Bands}" Margin="12,2,0,0" ToolTip="{Binding BandTip}"
                                                                              Visibility="{Binding HasBands, Converter={StaticResource BoolToVis}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13" Margin="0,0,12,0" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" Margin="12,2,0,0"
                                                                            Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Needs:" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,8,0" />
                                                                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" Margin="0,0,12,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Facts -->
                        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3" Padding="16,14" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Details" FontFamily="{DynamicResource Serif}" FontSize="16"
                                           Foreground="{StaticResource Gold}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Label}" FontSize="11"
                                                           Foreground="{StaticResource Dim}" />
                                                <TextBox Style="{StaticResource CopyText}" Text="{Binding Value, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add to craft list" Style="{StaticResource PillButton}"
                                        Visibility="{Binding CanCraft, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.AddSelectedToCraftCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Content="Add to gear set" Style="{StaticResource PillButton}" Margin="0,8,0,0"
                                        ToolTip="{Binding DataContext.GearSetLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding DataContext.AddSelectedToGearCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Content="Copy as text" Style="{StaticResource PillButton}" Margin="0,8,0,0"
                                        Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===== Recipes view ===== -->
            <Border Grid.Column="1" Margin="8,0,14,8" Padding="14,12"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="3"
                    Visibility="{Binding IsRecipesView, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding Professions}" SelectedItem="{Binding SelectedProfession}"
                         ItemContainerStyle="{StaticResource ChipItem}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <TextBox Grid.Row="1" Style="{StaticResource FilterTextBox}" Margin="0,4,0,6"
                         Tag="Filter by recipe or reagent name"
                         local:ListKeys.Target="{Binding ElementName=RecipeList}"
                         Text="{Binding RecipeFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddToCraftCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=RecipeList}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Grid Grid.Row="2" Margin="2,0,0,6">
                    <TextBlock Text="{Binding RecipeInfo}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Sort by" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="150" ItemsSource="{Binding RecipeSorts}" SelectedIndex="{Binding RecipeSortIndex}" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="RecipeList" Grid.Row="3" ItemsSource="{Binding Recipes}"
                         ItemContainerStyle="{StaticResource RecipeItem}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,14,0"> <!-- room for the overlay scroll bar -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="38" Height="38"
                                            Margin="0,0,10,0" VerticalAlignment="Top">
                                        <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                    </Border>
                                    <StackPanel>
                                        <TextBox Style="{StaticResource CopyText}" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush}" FontSize="15" />
                                        <TextBox Style="{StaticResource CopyText}" Text="{Binding Meta, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Dim}" />
                                        <!-- The crafted item: slot/type/levels, stats, green effects -->
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding ItemLine, Mode=OneWay}" FontSize="12"
                                                 Foreground="{StaticResource Dim}" Margin="0,3,0,0" />
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding StatLine, Mode=OneWay}" FontSize="13" Margin="0,1,0,0" />
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding EffectLine, Mode=OneWay}" FontSize="12"
                                                 Foreground="{StaticResource Green}" Margin="0,1,0,0" />
                                        <!-- Reagents in their rarity colours -->
                                        <ItemsControl ItemsSource="{Binding ReagentChips}" Margin="0,3,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" Margin="0,0,12,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Skill-up bands: orange always +1, yellow usually, green sometimes, grey never. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" ToolTip="{Binding SkillTip}">
                                            <TextBlock Text="{Binding Orange}" FontSize="12" Foreground="#FF8040" />
                                            <TextBlock Text="{Binding Yellow}" FontSize="12" Foreground="#FFFF00" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding Green}" FontSize="12" Foreground="#40BF40" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding Grey}" FontSize="12" Foreground="#9D9D9D" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Button Grid.Column="1" Content="+ Craft list" Style="{StaticResource PillButton}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        Command="{Binding DataContext.AddToCraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </Border>

            <!-- ===== Crafting view: the craft list, and leveling a profession ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsCraftView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListBox SelectedIndex="{Binding CraftModeIndex}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                         ItemContainerStyle="{StaticResource ChipItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="Craft list" />
                    <ListBoxItem Content="Level a profession" />
                </ListBox>

                <!-- Craft list -->
                <Grid Grid.Row="1" Visibility="{Binding IsCraftListMode, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding CraftIsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nothing queued yet." FontFamily="{DynamicResource Serif}" FontSize="18"
                               Foreground="{StaticResource Dim}" TextAlignment="Center" />
                    <TextBlock Text="Add recipes from the Recipes tab, or from an item's details."
                               FontSize="12" Foreground="{StaticResource Dim}" Opacity="0.8" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CraftHasItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,14,0"> <!-- room for the overlay scroll bar -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Craft list" FontFamily="{DynamicResource Serif}" FontSize="16"
                                                   Foreground="{StaticResource Gold}" />
                                        <TextBlock Text="{Binding CraftSummary}" FontSize="12"
                                                   Foreground="{StaticResource Dim}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="✓ Complete all" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                                Command="{Binding CompleteAllCraftCommand}" ToolTip="Tick off every recipe" />
                                        <Button Content="Clear completed" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                                Command="{Binding ClearCompletedCraftCommand}"
                                                Visibility="{Binding HasDoneCrafts, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Clear" Style="{StaticResource PillButton}"
                                                Command="{Binding ClearCraftCommand}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CraftList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Opacity="{Binding RowOpacity}">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="34" Height="34" Margin="0,0,10,0">
                                                        <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBox Style="{StaticResource CopyText}" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush}" FontSize="15" />
                                                        <TextBox Style="{StaticResource CopyText}" Text="{Binding Meta, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Dim}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{Binding DoneText}" Style="{StaticResource PillButton}" Padding="9,3" Margin="0,0,10,0"
                                                            ToolTip="{Binding DoneTip}" MinWidth="70"
                                                            Command="{Binding DataContext.ToggleCraftDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="-" Style="{StaticResource PillButton}" Padding="9,3"
                                                            Command="{Binding DataContext.DecreaseCraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Quantity}" MinWidth="28" Margin="6,0"
                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Parchment}" />
                                                    <Button Content="+" Style="{StaticResource PillButton}" Padding="9,3"
                                                            Command="{Binding DataContext.IncreaseCraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remove" Style="{StaticResource PillButton}" Margin="10,0,0,0"
                                                            Command="{Binding DataContext.RemoveCraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Shopping list" FontFamily="{DynamicResource Serif}" FontSize="16"
                                                   Foreground="{StaticResource Gold}" />
                                        <TextBlock Text="Reagents for everything above" FontSize="12"
                                                   Foreground="{StaticResource Dim}" />
                                    </StackPanel>
                                    <Button Content="Copy" Style="{StaticResource PillButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Command="{Binding CopyShoppingCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Shopping}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Amount}" Foreground="{StaticResource Parchment}" MinWidth="36" />
                                                <TextBox Style="{StaticResource CopyText}" Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                            </Grid>

                <!-- Level a profession (MainViewModel.Planner) -->
                <Grid Grid.Row="1" Visibility="{Binding IsPlannerMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Inputs -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                            Padding="14,10" Margin="0,0,14,10">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,6">
                                    <TextBlock Text="Character" FontSize="11" Foreground="{StaticResource Dim}" />
                                    <ComboBox ItemsSource="{Binding PlanCharacters}" SelectedItem="{Binding PlanCharacter}" MinWidth="170" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,6">
                                    <TextBlock Text="Profession" FontSize="11" Foreground="{StaticResource Dim}" />
                                    <ComboBox ItemsSource="{Binding PlanProfessions}" SelectedItem="{Binding PlanProfession}" MinWidth="150" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="Skill now" FontSize="11" Foreground="{StaticResource Dim}" />
                                    <TextBox Style="{StaticResource FilterTextBox}" Width="70"
                                             Text="{Binding PlanFromText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,6">
                                    <TextBlock Text="Goal" FontSize="11" Foreground="{StaticResource Dim}" />
                                    <TextBox Style="{StaticResource FilterTextBox}" Width="70"
                                             Text="{Binding PlanToText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Content="Vendor recipes" IsChecked="{Binding PlanVendorRecipes}" Foreground="{StaticResource Parchment}"
                                          Margin="0,0,14,0" ToolTip="Recipes you can buy from a vendor" />
                                <CheckBox Content="Found recipes" IsChecked="{Binding PlanDropRecipes}" Foreground="{StaticResource Parchment}"
                                          Margin="0,0,14,0" ToolTip="Recipes from drops and quests (the ones you know are always used)" />
                                <CheckBox Content="Make sub-parts" IsChecked="{Binding PlanSubParts}" Foreground="{StaticResource Parchment}"
                                          Margin="0,0,14,0" ToolTip="Bolts, cured leather, rods… are made from their own reagents" />
                                <CheckBox Content="I smelt my own bars" IsChecked="{Binding PlanSmelt}" Foreground="{StaticResource Parchment}"
                                          ToolTip="Bars become ore in the shopping list" />
                            </WrapPanel>
                            <TextBlock Text="{Binding PlanCharacterNote}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,14,0">
                            <!-- Route -->
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                    Padding="16,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Copy" Style="{StaticResource PillButton}" Command="{Binding CopyPlanCommand}" Margin="0,0,6,0" />
                                            <Button Content="Add all to craft list" Style="{StaticResource PillButton}" Command="{Binding SendPlanToCraftCommand}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="The route" FontFamily="{DynamicResource Serif}" FontSize="16" Foreground="{StaticResource Gold}" />
                                            <TextBlock Text="{Binding PlanSummary}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PlanNotes}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasPlanNotes, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#FF8040" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding PlanSteps}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Range}" Width="72" FontSize="14"
                                                                   Foreground="{Binding ColorBrush}" VerticalAlignment="Top" Margin="0,2,0,0"
                                                                   ToolTip="{Binding ColorText}" />
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="32" Height="32" Margin="0,0,10,0"
                                                                VerticalAlignment="Top">
                                                            <local:GameIcon FileId="{Binding IconId}" IconName="inv_misc_questionmark" Size="medium" />
                                                        </Border>
                                                        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding CraftsText}" FontSize="14" Foreground="{StaticResource Parchment}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding CostText}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Recipe}" FontSize="14" Foreground="{StaticResource Parchment}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Reagents}" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource Gold}" Opacity="0.8" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Materials -->
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3"
                                    Padding="16,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Replan with what I have" Style="{StaticResource PillButton}" Command="{Binding ReplanFromHaveCommand}"
                                                    Margin="0,0,6,0" ToolTip="Materials you have count cheaper, so the route may change" />
                                            <Button Content="Clear typed counts" Style="{StaticResource PillButton}" Command="{Binding ClearTypedHaveCommand}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Materials" FontFamily="{DynamicResource Serif}" FontSize="16" Foreground="{StaticResource Gold}" />
                                            <TextBlock Text="Need · have (from bags and bank, or type it) · still to get" FontSize="12" Foreground="{StaticResource Dim}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PlanMaterials}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="26" Height="26" Margin="0,0,8,0"
                                                            MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave">
                                                        <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ToGet}" Width="44" TextAlignment="Right" FontSize="14"
                                                               Foreground="{StaticResource Gold}" VerticalAlignment="Center" ToolTip="Still to get" />
                                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource FilterTextBox}" Width="54" Margin="8,0,0,0"
                                                             Text="{Binding HaveText, UpdateSourceTrigger=PropertyChanged, Delay=500}" ToolTip="You have" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Width="44" TextAlignment="Right" FontSize="14"
                                                               Foreground="{StaticResource Parchment}" VerticalAlignment="Center" ToolTip="Needed" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource Dim}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Made along the way" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,12,0,2"
                                               Visibility="{Binding HasPlanSubCrafts, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding PlanSubCrafts}"
                                                  Visibility="{Binding HasPlanSubCrafts, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="22" Height="22" Margin="0,0,8,0">
                                                        <local:GameIcon FileId="{Binding IconId}" Size="small" />
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center" FontSize="13">
                                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource Dim}" FontSize="11" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===== Spells view ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsSpellsView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding SpellClasses}" SelectedItem="{Binding SelectedSpellClass}"
                         ItemContainerStyle="{StaticResource ChipItem}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SpellFilterBox" Style="{StaticResource FilterTextBox}" Tag="Filter by spell name or description"
                             local:ListKeys.Target="{Binding ElementName=SpellList}"
                             Text="{Binding SpellFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <TextBlock Grid.Column="1" Text="{Binding SpellInfo}" FontSize="12" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" Margin="10,0,2,0" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3">
                        <ListBox x:Name="SpellList" ItemsSource="{Binding Spells}" SelectedItem="{Binding SelectedSpellRow}"
                                 ItemContainerStyle="{StaticResource RecipeItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="30" Height="30" Margin="0,0,8,0">
                                            <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Parchment}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource Dim}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Column="2" Text="Pick a spell to see its numbers." FontSize="16"
                               Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,48,0,0"
                               Visibility="{Binding NoSpell, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSpell, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedSpell}">
                            <!-- Spell tooltip -->
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource IconFrame}" Width="48" Height="48" Margin="0,0,12,0">
                                                <local:GameIcon FileId="{Binding IconId}" Size="large" />
                                            </Border>
                                            <TextBox Style="{StaticResource CopyText}" Text="{Binding Name, Mode=OneWay}"
                                                     FontSize="20" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBox Style="{StaticResource CopyText}" Text="{Binding Rank, Mode=OneWay}"
                                                 Foreground="{StaticResource Dim}" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" FontSize="13" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding CostLine, Mode=OneWay}" HorizontalAlignment="Left" />
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding RangeLine, Mode=OneWay}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding CastLine, Mode=OneWay}" HorizontalAlignment="Left" />
                                        <TextBox Style="{StaticResource CopyLine}" Text="{Binding CooldownLine, Mode=OneWay}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBox Style="{StaticResource CopyLine}" Text="{Binding Description, Mode=OneWay}"
                                             Foreground="{StaticResource Gold}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Numbers -->
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Numbers" FontSize="16" Foreground="{StaticResource Gold}" />
                                        <Button Content="Copy as text" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.CopySpellCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Dim}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Style="{StaticResource CopyText}" Text="{Binding Value, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Effects" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,10,0,0" />
                                    <ItemsControl ItemsSource="{Binding EffectLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource CopyLine}" Text="{Binding Mode=OneWay}" FontSize="13" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===== Talents view ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsTalentsView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding TalentClasses}" SelectedItem="{Binding SelectedTalentClass}"
                         ItemContainerStyle="{StaticResource ChipItem}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconFrame}" Width="20" Height="20" Margin="0,0,6,0" CornerRadius="2">
                                    <local:GameIcon FileId="{Binding IconId}" Size="small" />
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Summary bar: tree tabs, level, points, actions -->
                <Border Grid.Row="1" Margin="0,4,0,8" Padding="12,8" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding TalentSummary}" FontSize="16" Foreground="{StaticResource Gold}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Level" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource FilterTextBox}" Width="54" Margin="6,0,10,0" Padding="6,3"
                                         Text="{Binding TalentLevel, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                <TextBlock Text="{Binding PointsLeftText}" FontSize="12" Foreground="{StaticResource Parchment}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ToggleButton IsChecked="{Binding ShowAllTrees}" Margin="0,0,10,0" Padding="10,4" Cursor="Hand"
                                          ToolTip="Show all three trees, or one at a time">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame" Padding="10,4" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                                            <TextBlock x:Name="Label" Text="All trees" FontSize="12" Foreground="{StaticResource Dim}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Gold}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Button Content="Reset tree" Style="{StaticResource PillButton}" Command="{Binding ResetTreeCommand}" />
                            <Button Content="Reset all" Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Command="{Binding ResetAllTalentsCommand}" />
                            <Button Content="Copy text" Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Command="{Binding CopyTalentsCommand}" ToolTip="Copy the build as readable text, with both calculator links" />
                            <Button Content="Share / import" Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Command="{Binding ToggleSharePanelCommand}" ToolTip="Icy Veins and Wowhead links: export this build or import one" />
                        </StackPanel>

                        <!-- Second row spans the full width, so nothing hides behind the buttons above. -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <!-- Talent sets for this class -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Talent set" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                <ComboBox Width="240" Margin="8,0,8,0" ItemsSource="{Binding TalentSets}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedTalentSet}" />
                                <TextBox Style="{StaticResource FilterTextBox}" Width="200" Padding="6,3" Tag="Set name"
                                         Text="{Binding TalentSetName, UpdateSourceTrigger=PropertyChanged}">
                                <!-- Enter does what the button next to it does -->
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RenameTalentSetCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                                <Button Content="Rename" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding RenameTalentSetCommand}" />
                                <Button Content="New" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding NewTalentSetCommand}" />
                                <Button Content="Duplicate" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding DuplicateTalentSetCommand}" />
                                <Button Content="Delete" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding DeleteTalentSetCommand}" />
                            </StackPanel>

                            <!-- Share panel: one box per site, export on top, import below. -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsSharePanelOpen, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="0,0,5,0" Padding="10,8" CornerRadius="3" Background="{StaticResource PanelRaised}"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Icy Veins" FontSize="14" Foreground="{StaticResource Gold}" />
                                    <TextBlock Text="Export: this build" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,6,0,3" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding CopyIcyVeinsLinkCommand}" />
                                        <TextBox Style="{StaticResource FilterTextBox}" Padding="6,3" IsReadOnly="True" Text="{Binding IcyVeinsExport, Mode=OneWay}" />
                                    </DockPanel>
                                    <TextBlock Text="Import: paste a link, becomes a new set" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,8,0,3" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Import" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding ImportIcyVeinsCommand}" />
                                        <TextBox Style="{StaticResource FilterTextBox}" Padding="6,3" Tag="…/mage-talent-calculator#tc-…"
                                                 Text="{Binding IcyVeinsImport, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ImportIcyVeinsCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                                    <Border Grid.Column="1" Margin="5,0,0,0" Padding="10,8" CornerRadius="3" Background="{StaticResource PanelRaised}"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Wowhead" FontSize="14" Foreground="{StaticResource Gold}" />
                                    <TextBlock Text="Export: this build" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,6,0,3" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding CopyWowheadLinkCommand}" />
                                        <TextBox Style="{StaticResource FilterTextBox}" Padding="6,3" IsReadOnly="True" Text="{Binding WowheadExport, Mode=OneWay}" />
                                    </DockPanel>
                                    <TextBlock Text="Import: paste a link, becomes a new set" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,8,0,3" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Import" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding ImportWowheadCommand}" />
                                        <TextBox Style="{StaticResource FilterTextBox}" Padding="6,3" Tag="…/forever/talent-calc/mage/v2…"
                                                 Text="{Binding WowheadImport, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ImportWowheadCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                                </Grid>
                                <TextBlock Text="{Binding ShareNotesTitle}" FontSize="12" Foreground="{StaticResource Parchment}" Margin="2,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ShareError}" Foreground="#FF6B5B" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ShareWarnings}" Margin="2,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="#FFB84D" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- One tree at a time, tabs underneath, description on the right. -->
                <Grid Grid.Row="2" Visibility="{Binding ShowOneTree, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding Trees}" SelectedItem="{Binding CurrentTree}"
                                 ItemContainerStyle="{StaticResource ChipItem}" Margin="0,8,0,0"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconFrame}" Width="20" Height="20" Margin="0,0,6,0" CornerRadius="2">
                                            <local:GameIcon FileId="{Binding IconId}" Size="small" />
                                        </Border>
                                        <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- The tree grows and shrinks with the window. -->
                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <ContentControl Width="428" Content="{Binding CurrentTree}" ContentTemplate="{StaticResource TalentTreeBody}" />
                        </Viewbox>
                    </DockPanel>
                    <TextBlock Grid.Column="2" Text="Hover a talent to read it. Left click adds a point, right click removes one."
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Top" Margin="4,4,0,0" />
                </Grid>

                <!-- All three trees side by side, scaled to fill the space (grow and shrink with the window). -->
                <Grid Grid.Row="2" Visibility="{Binding ShowAllTrees, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding Trees}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="408" Margin="0,0,14,0">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TreeHeader}" />
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TalentTreeBody}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Margin="2,6,0,0" FontSize="12" Foreground="{StaticResource Dim}"
                               Text="Hover a talent to read it. Left click adds a point, right click removes one." />
                </Grid>
            </Grid>

            <!-- ===== Gear view ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsGearView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Set toolbar -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,10" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gear set" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            <ComboBox Width="280" Margin="8,0,8,0" ItemsSource="{Binding GearSets}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedGearSet}" />
                            <Button Content="New set" Style="{StaticResource PillButton}" Command="{Binding NewGearSetCommand}" />
                            <Button Content="Delete" Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Command="{Binding DeleteGearSetCommand}" />
                            <Button Content="Import character" Style="{StaticResource PillButton}" Margin="14,0,0,0"
                                    ToolTip="Paste what the WoWOracle addon copied in game (you or an inspected player)"
                                    Command="{Binding ToggleCharacterImportCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding HasGearSet, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource FilterTextBox}" Width="240" Padding="6,3" Tag="Set name"
                                     Text="{Binding GearSetName, UpdateSourceTrigger=PropertyChanged}">
                                <!-- Enter does what the button next to it does -->
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RenameGearSetCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Rename" Style="{StaticResource PillButton}" Margin="6,0,14,0"
                                    Command="{Binding RenameGearSetCommand}" />
                            <TextBlock Text="Gear sets are just items. Class, race and level are set in the Calculator."
                                       FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Import a character copied in game with the WoWOracle addon -->
                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="3" Background="{StaticResource PanelRaised}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                Visibility="{Binding IsCharacterImportOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Import character" FontSize="14" Foreground="{StaticResource Gold}" />
                                <TextBlock Text="In game: click Oracle on your character or the inspect window (or type /oracle, /oracle t for your target), press Ctrl+C, paste here. Makes a gear set and a talent set named after the character."
                                           FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                <TextBox Style="{StaticResource MultiLineTextBox}" Height="90" FontSize="12" Tag="!WOWORACLE 1 …"
                                         Text="{Binding CharacterImportText, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Import" Style="{StaticResource PillButton}" Command="{Binding ImportCharacterCommand}" />
                                    <Button Content="Close" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding ToggleCharacterImportCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding CharacterImportError}" Foreground="#FF6B5B" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding CharacterImportNotes}" Margin="2,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource Parchment}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,40,0,0" HorizontalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding NoGearSet, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No gear sets yet." FontSize="18" Foreground="{StaticResource Dim}" TextAlignment="Center" />
                    <TextBlock Text="Make one with New set, or open any item and press Add to gear set. Shift+Enter (or Shift+click) in the search list adds the item; Ctrl+Enter (or Ctrl+click) queues its recipe."
                               FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Visibility="{Binding HasGearSet, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Paper doll as a list -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            CornerRadius="3" Padding="12,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <!-- Right margin keeps the overlay scroll bar off the Open/Remove buttons. -->
                            <ItemsControl ItemsSource="{Binding GearRows}" Margin="0,0,16,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,5" Background="Transparent"
                                                MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SlotName}" FontSize="12" Foreground="{StaticResource Dim}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Style="{StaticResource IconFrame}" Width="32" Height="32" Margin="0,0,10,0">
                                                    <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemName}" Foreground="{Binding NameBrush}"
                                                               FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding EnchantText}" Foreground="{StaticResource Green}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasEnchant, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Upgrades" Style="{StaticResource PillButton}" Padding="8,2"
                                                            ToolTip="Alternatives for this slot, with where they drop"
                                                            Command="{Binding DataContext.FindUpgradesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasItem, Converter={StaticResource BoolToVis}}">
                                                        <Button Content="Enchant" Style="{StaticResource PillButton}" Padding="8,2" Margin="6,0,0,0"
                                                                ToolTip="Pick an enchant, oil or kit for this item" Click="OnEnchantClick"
                                                                Visibility="{Binding CanEnchant, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Open" Style="{StaticResource PillButton}" Padding="8,2" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.OpenGearItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Remove" Style="{StaticResource PillButton}" Padding="8,2" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RemoveGearItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- What the gear adds (hidden while the upgrade finder is open) -->
                    <Border Grid.Column="2" Width="250" VerticalAlignment="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3" Padding="14,12"
                            Visibility="{Binding ShowGearTotals, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Gear totals" FontSize="16" Foreground="{StaticResource Gold}" />
                            <TextBlock Text="Ratings are shown raw; the Calculator turns them into %." FontSize="11"
                                       Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding GearTotals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Parchment}" />
                                            <TextBlock Text="{Binding Value}" FontSize="13" Foreground="{StaticResource Green}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Upgrade finder: alternatives for one slot -->
                    <Border Grid.Column="2" Width="470" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                            BorderThickness="1" CornerRadius="3" Padding="12,10"
                            Visibility="{Binding IsUpgradePanelOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PillButton}" Command="{Binding CloseUpgradesCommand}" />
                                    <TextBlock Text="{Binding UpgradeTitle}" FontSize="16" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding UpgradeWeights}" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <WrapPanel Margin="0,8,0,4">
                                    <CheckBox Content="Raid" IsChecked="{Binding UpgradeRaid}" Margin="0,0,14,0" Foreground="{StaticResource Parchment}" />
                                    <CheckBox Content="Dungeon" IsChecked="{Binding UpgradeDungeon}" Margin="0,0,14,0" Foreground="{StaticResource Parchment}" />
                                    <CheckBox Content="World drops" IsChecked="{Binding UpgradeWorld}" Foreground="{StaticResource Parchment}" />
                                </WrapPanel>
                                <TextBlock Text="Searching…" FontSize="12" Foreground="{StaticResource Dim}"
                                           Visibility="{Binding UpgradeBusy, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding UpgradeNote}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                                <TextBlock Text="Click to open · Equip puts it in this slot · hold Alt to compare" FontSize="11"
                                           Foreground="{StaticResource Dim}" Opacity="0.8" Margin="0,2,0,6" />
                            </StackPanel>
                            <ScrollViewer x:Name="UpgradeList" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Upgrades}" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ClickRow}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                                                    MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                                        <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                                    </Border>
                                                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GainText}" Foreground="{Binding GainBrush}" FontSize="15" HorizontalAlignment="Right" />
                                                        <Button Content="Equip" Style="{StaticResource PillButton}" Padding="8,1" Margin="0,3,0,0"
                                                                Command="{Binding DataContext.EquipUpgradeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource MapButton}" Margin="0,4,0,0" HorizontalAlignment="Right"
                                                                Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatLine}" Foreground="{StaticResource Green}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding LevelText}" Foreground="{StaticResource Dim}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Loot view (AtlasLoot style) ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsLootView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LootFilterBox" Style="{StaticResource FilterTextBox}" Tag="Dungeon, raid or boss…"
                             ToolTip="↑ ↓ or Tab: places · Ctrl+↑ ↓: bosses · Enter: first match"
                             Text="{Binding LootFilter, UpdateSourceTrigger=PropertyChanged, Delay=120}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenFirstLootPlaceCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <CheckBox Content="Show grey/white items and world drops" IsChecked="{Binding LootShowAll}" Foreground="{StaticResource Parchment}" />
                        <TextBlock Text="{Binding LootStatus}" FontSize="12" Foreground="{StaticResource Dim}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Instances (and bosses matching the search) -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                        <ListBox x:Name="LootPlacesList" ItemsSource="{Binding LootPlaces}" SelectedItem="{Binding SelectedLootPlace}"
                                 ItemContainerStyle="{StaticResource RecipeItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Bosses of the chosen instance -->
                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                        <ListBox x:Name="LootBossesList" ItemsSource="{Binding LootBosses}" SelectedItem="{Binding SelectedLootBoss}"
                                 ItemContainerStyle="{StaticResource RecipeItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Dim}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Loot of the chosen boss -->
                    <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            CornerRadius="3" Padding="12,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding LootTitle}" FontSize="18" Foreground="{StaticResource Gold}" />
                                <TextBlock Text="{Binding LootSubtitle}" FontSize="12" Foreground="{StaticResource Parchment}" />
                                <TextBlock Text="Click opens · Shift+click adds to gear · Ctrl+click queues the recipe · hold Alt to compare. In the search box: ↑ ↓ / Tab for places, Ctrl+↑ ↓ for bosses. Drop data is Classic (CMaNGOS)."
                                           FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="LootList" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LootSections}" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource MapButton}" Margin="6,0,0,0"
                                                            Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding MapText}" />
                                                    <Button DockPanel.Dock="Right" Content="Quest details" Style="{StaticResource PillButton}" Padding="8,1"
                                                            Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Who gives it, where, its chain and the quest text"
                                                            Visibility="{Binding IsQuest, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.OpenLootQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Header}" FontSize="14" Foreground="{StaticResource Gold}" TextWrapping="Wrap"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Subheading}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasSubheading, Converter={StaticResource BoolToVis}}" />
                                                <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,4,0,4" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ClickRow}" MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave">
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                        <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding StatText}" Foreground="{StaticResource Parchment}" FontSize="12" TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasStatText, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding EffectText}" Foreground="{StaticResource Green}" FontSize="12" TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasEffectText, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Journal view (MainViewModel.Journal): a quest-log page per zone ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsJournalView, Converter={StaticResource BoolToVis}}">
                <Grid.Resources>
                    <LinearGradientBrush x:Key="Page" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#241B12" Offset="0" />
                        <GradientStop Color="#1B140D" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="Ink" Color="#EADBB8" />
                    <SolidColorBrush x:Key="InkSoft" Color="#A8977A" />
                    <SolidColorBrush x:Key="InkTitle" Color="#FFD100" />
                    <SolidColorBrush x:Key="InkTheme" Color="#D9A55A" />
                    <CollectionViewSource x:Key="ZonesByContinent" Source="{Binding JournalZones}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Continent" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Zone list, by continent -->
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                            <TextBlock Text="Journal" FontSize="16" Foreground="{StaticResource Gold}" />
                            <ListBox SelectedIndex="{Binding JournalSideIndex}" Background="Transparent" BorderThickness="0" Padding="0"
                                     Margin="0,8,0,0" ItemContainerStyle="{StaticResource ChipItem}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem Content="Both" ToolTip="Tales for both factions" />
                                <ListBoxItem Content="Alliance" />
                                <ListBoxItem Content="Horde" />
                            </ListBox>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Source={StaticResource ZonesByContinent}}" SelectedItem="{Binding SelectedJournalZone}"
                                 ItemContainerStyle="{StaticResource RecipeItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Gold}" Opacity="0.85"
                                                       Margin="10,10,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Levels}" FontSize="11" Foreground="{StaticResource Dim}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Zone}" FontSize="14" Foreground="{StaticResource Parchment}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- The page -->
                <Border Grid.Column="2" Background="{StaticResource Page}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
                        <StackPanel MaxWidth="760">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open the map" Style="{StaticResource PillButton}" VerticalAlignment="Center"
                                        Foreground="{StaticResource InkTitle}"
                                        Command="{Binding OpenZoneMapCommand}" CommandParameter="{Binding SelectedJournalZone.Zone}" />
                                <TextBlock Text="{Binding SelectedJournalZone.Zone}" FontSize="28" Foreground="{StaticResource InkTitle}"
                                           FontFamily="{DynamicResource Serif}" />
                            </DockPanel>
                            <TextBlock Text="{Binding JournalZoneLine}" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" />
                            <TextBlock Text="— ✦ —" FontSize="14" Foreground="{StaticResource InkTheme}" HorizontalAlignment="Center"
                                       Margin="0,12,0,8" />
                            <TextBlock Text="{Binding SelectedJournalZone.Summary}" FontSize="15" Foreground="{StaticResource Ink}"
                                       TextWrapping="Wrap" LineHeight="22" />

                            <!-- Tales -->
                            <DockPanel Margin="0,22,0,2">
                                <TextBlock DockPanel.Dock="Right" Text="The Oracle is listening…" FontSize="11" FontStyle="Italic"
                                           Foreground="{StaticResource InkSoft}" VerticalAlignment="Bottom"
                                           Visibility="{Binding JournalBusy, Converter={StaticResource BoolToVis}}" />
                                <TextBlock FontSize="19" Foreground="{StaticResource InkTitle}">
                                    <Run Text="Tales of " /><Run Text="{Binding SelectedJournalZone.Zone, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource InkSoft}" Opacity="0.4" Margin="0,4,0,10" />
                            <TextBlock Text="{Binding JournalTalesNote}" FontSize="13" FontStyle="Italic" Foreground="{StaticResource InkSoft}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Tales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock FontSize="17" Foreground="{StaticResource InkTitle}" TextWrapping="Wrap">
                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                <Run Text="{Binding Star, Mode=OneWay}" FontSize="12" Foreground="{StaticResource InkTheme}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Themes}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource InkTheme}"
                                                       Margin="0,1,0,0" Visibility="{Binding HasThemes, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Teaser}" FontSize="13" FontStyle="Italic" Foreground="{StaticResource Ink}"
                                                       TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="19"
                                                       Visibility="{Binding HasTeaser, Converter={StaticResource BoolToVis}}" />
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource MapButton}" Margin="0,0,7,0"
                                                        Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Start}" FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Button Content="{Binding TrailText}" HorizontalAlignment="Left" Margin="0,6,0,0" Cursor="Hand"
                                                    Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ToggleTaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="Link" Text="{TemplateBinding Content}" FontSize="12"
                                                                   Foreground="{StaticResource InkTitle}" TextDecorations="Underline" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Link" Property="Foreground" Value="#FFF0A0" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Steps}" Margin="10,6,0,0"
                                                          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Cursor="Hand" HorizontalAlignment="Left" ToolTip="Search for this quest's rewards"
                                                                Command="{Binding DataContext.ShowQuestRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Row" Background="Transparent" Padding="4,2" CornerRadius="2">
                                                                        <TextBlock FontSize="12" Foreground="{StaticResource Ink}">
                                                                            <Run Text="{Binding Number, Mode=OneWay}" Foreground="{StaticResource InkSoft}" /><Run Text=".  " Foreground="{StaticResource InkSoft}" /><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Meta, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkSoft}" />
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Row" Property="Background" Value="#33A0702A" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Seek another tale…" HorizontalAlignment="Left" Cursor="Hand" Command="{Binding SeekTaleCommand}"
                                    Visibility="{Binding CanSeekTale, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Frame" BorderBrush="{StaticResource InkSoft}" BorderThickness="1" CornerRadius="3"
                                                Padding="12,5" Background="#22FFFFFF">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="13" Foreground="{StaticResource InkTitle}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="Background" Value="#33A0702A" />
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource InkTitle}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Gear hint -->
                            <TextBlock Text="The Oracle's gear hint" FontSize="19" Foreground="{StaticResource InkTitle}" Margin="0,26,0,0" />
                            <Border Height="1" Background="{StaticResource InkSoft}" Opacity="0.4" Margin="0,4,0,8" />
                            <Button Content="Ask the Oracle for a gear hint" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                    Command="{Binding RevealGearHintCommand}"
                                    Visibility="{Binding JournalGearHidden, Converter={StaticResource BoolToVis}}"
                                    ToolTip="A quest reward in this zone that beats what your active gear set wears" />
                            <TextBlock Text="{Binding JournalGearNote}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource InkSoft}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding JournalGearRevealed, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding JournalGearHints}"
                                          Visibility="{Binding JournalGearRevealed, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                                CornerRadius="3" Padding="8,6" Margin="0,0,0,6" Cursor="Hand"
                                                MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenUpgradeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="38" Height="38" Margin="0,0,10,0">
                                                    <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                                </Border>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource MapButton}" Margin="8,0,0,0"
                                                        Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding GainText}" Foreground="{Binding GainBrush}" FontSize="14"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourceText}" Foreground="{Binding SourceBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatLine}" Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Map view (MainViewModel.Map): the game's zone maps with markers ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsMapView, Converter={StaticResource BoolToVis}}">
                <Grid.Resources>
                    <CollectionViewSource x:Key="MapsByContinent" Source="{Binding MapZones}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Continent" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                            <TextBlock Text="Map" FontSize="16" Foreground="{StaticResource Gold}" />
                            <CheckBox IsChecked="{Binding ShowTalePins}" Margin="0,8,0,0" Foreground="{StaticResource Parchment}" FontSize="12"
                                      Content="Mark where the tales begin" ToolTip="The Journal's tales of the zone, marked with a gold !" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Source={StaticResource MapsByContinent}}" SelectedItem="{Binding SelectedMapZone}"
                                 ItemContainerStyle="{StaticResource RecipeItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Gold}" Opacity="0.85"
                                                       Margin="10,10,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Parchment}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="#0B0805" BorderBrush="{StaticResource Edge}" BorderThickness="2" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="MapScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="OnMapWheel" SizeChanged="OnMapViewportChanged">
                            <Grid x:Name="MapSurface" Width="{Binding MapWidth}" Height="{Binding MapHeight}" Background="Transparent"
                                  MouseMove="OnMapMouseMove" MouseLeave="OnMapMouseLeave"
                                  MouseLeftButtonDown="OnMapDragStart" MouseLeftButtonUp="OnMapDragEnd">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1" />
                                </Grid.LayoutTransform>
                                <Image Source="{Binding MapImage}" Stretch="Fill" />
                                <ItemsControl ItemsSource="{Binding MapPins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas ToolTip="{Binding Tip}">
                                                <!-- A tale begins here: the gold "!" of a quest giver -->
                                                <Grid Canvas.Left="-9" Canvas.Top="-30" Width="18" Height="32" Background="Transparent"
                                                      Visibility="{Binding IsTale, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Gold}"
                                                               HorizontalAlignment="Center" FontFamily="{DynamicResource Serif}">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="1" Color="Black" />
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </Grid>
                                                <!-- What you asked to see: a pulsing marker with its name -->
                                                <Canvas Visibility="{Binding IsFocus, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse Canvas.Left="-18" Canvas.Top="-18" Width="36" Height="36">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush>
                                                                <GradientStop Color="#C0FFD100" Offset="0" />
                                                                <GradientStop Color="#60FF8000" Offset="0.5" />
                                                                <GradientStop Color="#00FF8000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                        <Ellipse.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                                                                                         Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                    <Path Canvas.Left="-7" Canvas.Top="-7" Data="M 7,0 L 14,7 L 7,14 L 0,7 Z" Fill="#FFD100"
                                                          Stroke="#5A1A08" StrokeThickness="1.5" />
                                                    <Grid Canvas.Left="-150" Canvas.Top="-44" Width="300">
                                                        <Border HorizontalAlignment="Center" Background="#D0150C07" BorderBrush="{StaticResource Gold}"
                                                                BorderThickness="1" CornerRadius="3" Padding="7,2">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Gold}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </Canvas>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                        <TextBlock Text="{Binding MapStatus}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="30" IsHitTestVisible="False" />
                        <DockPanel Grid.Row="1" Margin="10,5" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedMapZone.Name}" FontSize="14" Foreground="{StaticResource Gold}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding MapCursorText}" FontSize="12" Foreground="{StaticResource Parchment}"
                                       Margin="12,1,0,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="Wheel to zoom · drag to move" FontSize="11" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Notes view ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Note list -->
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                            <Button DockPanel.Dock="Right" Content="New note" Style="{StaticResource PillButton}" Command="{Binding NewNoteCommand}" />
                            <TextBlock Text="Notes" FontSize="16" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                                 ItemContainerStyle="{StaticResource RecipeItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Padding="0" Width="20" Height="20" Margin="0,1,8,0" VerticalAlignment="Top"
                                                Content="{Binding DoneMark}" ToolTip="Mark done / not done"
                                                Command="{Binding DataContext.ToggleNoteDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" Opacity="{Binding TitleOpacity}"
                                                       FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Editor -->
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="3" Padding="14,12">
                    <Grid>
                        <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center" MaxWidth="380"
                                    Visibility="{Binding NoNote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Pick a note or make a new one." FontSize="18" Foreground="{StaticResource Dim}" TextAlignment="Center" />
                            <TextBlock Text="Notes are for things to check later: a vendor to visit, a recipe to buy, a reset to remember. Add a time and the app reminds you, even from the tray."
                                       FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="NoteTitleBox" Grid.Row="0" Style="{StaticResource FilterTextBox}" FontSize="18" Tag="Title"
                                     Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Reminder -->
                            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                <WrapPanel>
                                    <TextBlock Text="Remind" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Style="{StaticResource FilterTextBox}" Width="190" Padding="6,3" Tag="18:30, tomorrow 9:00, in 2h"
                                             Text="{Binding NoteWhen, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SaveNoteCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="+1 hour" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding QuickReminderCommand}" CommandParameter="1h" />
                                    <Button Content="This evening" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding QuickReminderCommand}" CommandParameter="evening" />
                                    <Button Content="Tomorrow 9:00" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding QuickReminderCommand}" CommandParameter="tomorrow" />
                                    <Button Content="No reminder" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding QuickReminderCommand}" CommandParameter="clear" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Repeat" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="110" ItemsSource="{Binding RepeatChoices}" SelectedItem="{Binding NoteRepeat}" />
                                    <CheckBox Content="Done" IsChecked="{Binding NoteDone}" Margin="16,0,0,0" Foreground="{StaticResource Parchment}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NoteWhenHint}" FontSize="12" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </WrapPanel>
                            </StackPanel>

                            <TextBox Grid.Row="2" Style="{StaticResource MultiLineTextBox}" Tag="Write anything…"
                                     Text="{Binding NoteBody, UpdateSourceTrigger=PropertyChanged}" />

                            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource PillButton}" Margin="6,0,0,0" Command="{Binding DeleteNoteCommand}" />
                                <Button DockPanel.Dock="Right" Content="Save (Ctrl+S)" Style="{StaticResource PillButton}" Command="{Binding SaveNoteCommand}" />
                                <TextBlock Text="Saved automatically when you switch note or page." FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Calculator view ===== -->
            <Grid Grid.Column="1" Margin="8,0,14,8"
                  Visibility="{Binding IsCalcView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,10" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding CalcHeader}" FontSize="16" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CalcTalentLine}" FontSize="12" Foreground="{StaticResource Dim}" />
                            </StackPanel>
                        </Grid>

                        <!-- Character: class, race, level; then gear, talents, target -->
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Class" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Width="120" ItemsSource="{Binding TalentClasses}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding CalcClass}" />
                                <TextBlock Text="Race" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox Width="120" ItemsSource="{Binding Races}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding CalcRace}" />
                                <TextBlock Text="Level" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox Style="{StaticResource FilterTextBox}" Width="50" Padding="6,3"
                                         Text="{Binding CalcLevel, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Gear" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="18,0,6,0" />
                                <ComboBox Width="230" ItemsSource="{Binding CalcGearChoices}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding CalcGearSet}" />
                                <TextBlock Text="Talents" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox Width="230" ItemsSource="{Binding CalcTalentSets}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCalcTalentSet}" />
                                <TextBlock Text="Target" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox Width="140" ItemsSource="{Binding TargetOptions}" SelectedIndex="{Binding TargetLevelDiff}" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- Saved calculations -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Saved" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                            <ComboBox Width="260" Margin="8,0,6,0" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding SavedText}" FontSize="11" Foreground="{StaticResource Dim}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Load" Style="{StaticResource PillButton}" Command="{Binding LoadSnapshotCommand}" />
                            <Button Content="Delete" Style="{StaticResource PillButton}" Margin="6,0,18,0" Command="{Binding DeleteSnapshotCommand}" />
                            <TextBox Style="{StaticResource FilterTextBox}" Width="200" Padding="6,3" Tag="Name (optional)"
                                     Text="{Binding SnapshotName, UpdateSourceTrigger=PropertyChanged}">
                                <!-- Enter does what the button next to it does -->
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveSnapshotCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Save calculation" Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Command="{Binding SaveSnapshotCommand}" />
                            <Button Content="Copy result" Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Command="{Binding CopyCalcResultCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SnapshotCompare}" FontSize="12" Foreground="{StaticResource Green}" TextWrapping="Wrap"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: character sheet, naked stats, buffs -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="3" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Character" FontSize="16" Foreground="{StaticResource Gold}" />
                                    <ItemsControl ItemsSource="{Binding SheetLines}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,8,0,2"
                                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                                                    <Grid Visibility="{Binding IsValue, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Parchment}" />
                                                        <TextBlock Text="{Binding Value}" FontSize="13" Foreground="{StaticResource Parchment}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding CalcNotes}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="3" Padding="14,12" Margin="0,10,0,0"
                                    Visibility="{Binding HasWeapons, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Weapons" FontSize="16" Foreground="{StaticResource Gold}" />
                                    <TextBlock Text="White hits vs the target; no dodge, parry or glancing yet." FontSize="11"
                                               Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding WeaponLines}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,8,0,2"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                                                    <Grid Visibility="{Binding IsValue, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Dim}"
                                                                   TextWrapping="Wrap" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{StaticResource Parchment}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="3" Padding="14,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Naked stats" FontSize="16" Foreground="{StaticResource Gold}" />
                                    <TextBlock Text="From your character sheet with nothing equipped, saved per class and race. Leave blank to use an estimate."
                                               FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    <UniformGrid Columns="5">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Str" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBox Style="{StaticResource FilterTextBox}" Padding="4,3" Text="{Binding NakedStr, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Agi" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBox Style="{StaticResource FilterTextBox}" Padding="4,3" Text="{Binding NakedAgi, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Sta" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBox Style="{StaticResource FilterTextBox}" Padding="4,3" Text="{Binding NakedSta, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Int" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBox Style="{StaticResource FilterTextBox}" Padding="4,3" Text="{Binding NakedInt, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Spi" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBox Style="{StaticResource FilterTextBox}" Padding="4,3" Text="{Binding NakedSpi, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="3" Padding="14,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Buffs and consumables" FontSize="16" Foreground="{StaticResource Gold}" />
                                    <ItemsControl ItemsSource="{Binding BuffToggles}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsOn}" Margin="0,2,0,0" ToolTip="{Binding Category}">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Parchment}" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: spell picker and results -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="230" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Style="{StaticResource FilterTextBox}" Tag="Filter damage spells" Margin="0,0,0,6"
                                 local:ListKeys.Target="{Binding ElementName=CalcSpellList}"
                                 Text="{Binding CalcFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3">
                            <ListBox x:Name="CalcSpellList" ItemsSource="{Binding CalcSpells}" SelectedItem="{Binding SelectedCalcSpell}"
                                     ItemContainerStyle="{StaticResource RecipeItem}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconFrame}" Width="26" Height="26" Margin="0,0,8,0">
                                                <local:GameIcon FileId="{Binding IconId}" Size="medium" />
                                            </Border>
                                            <TextBlock Text="{Binding Meta}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Dim}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Parchment}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3" Padding="14,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedSpellTitle}" FontSize="17" Foreground="{StaticResource Gold}"
                                                   VerticalAlignment="Center" Margin="0,0,170,0" TextTrimming="CharacterEllipsis" />
                                        <ComboBox Width="160" HorizontalAlignment="Right" ItemsSource="{Binding CalcRanks}"
                                                  SelectedItem="{Binding SelectedCalcRank}" ToolTip="Rank">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Dim}" FontSize="11"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DamageLines}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,8,0,2"
                                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                                                    <Grid Visibility="{Binding IsValue, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Dim}" />
                                                        <TextBox Grid.Column="1" Style="{StaticResource CopyText}" Text="{Binding Value, Mode=OneWay}" FontSize="13" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Race comparison: same gear, talents and buffs, each race's own naked stats (or estimate). -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRaceRows, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Race comparison" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Race" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBlock Grid.Column="1" Text="Per cast" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBlock Grid.Column="2" Text="DPS" FontSize="11" Foreground="{StaticResource Dim}" />
                                            <TextBlock Grid.Column="3" Text="Crit" FontSize="11" Foreground="{StaticResource Dim}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding RaceRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="RaceName" Text="{Binding Race}" FontSize="13" Foreground="{StaticResource Parchment}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PerCast}" FontSize="13" Foreground="{StaticResource Parchment}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Dps}" FontSize="13" Foreground="{StaticResource Parchment}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Crit}" FontSize="13" Foreground="{StaticResource Parchment}" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="RaceName" Property="Foreground" Value="{StaticResource Gold}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="Talents and notes" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,12,0,2" />
                                    <ItemsControl ItemsSource="{Binding DamageModifiers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource CopyLine}" Text="{Binding Mode=OneWay}" FontSize="12"
                                                         Foreground="{StaticResource Green}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Talent hover card: one shared popup, opened next to the hovered square and closed the moment the mouse
             leaves it. Not hit-testable, so it can never keep itself open or block the talents underneath. -->
        <!-- Enchant picker (Gear page): filter + list of enchants that fit the slot. Closes when clicking elsewhere. -->
        <Popup x:Name="EnchantPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsEnchantPickerOpen, Mode=TwoWay}">
            <Border Width="400" MaxHeight="460" Padding="12,10" CornerRadius="3" Background="{StaticResource PanelRaised}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="No enchant" Style="{StaticResource PillButton}" Padding="8,2"
                                    Command="{Binding RemoveEnchantCommand}" />
                            <TextBlock Text="{Binding EnchantPickerTitle}" FontSize="15" Foreground="{StaticResource Gold}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBox x:Name="EnchantFilterBox" Style="{StaticResource FilterTextBox}" Padding="8,4" Margin="0,8,0,6"
                                 Tag="Type to filter: agility, crusader, oil…"
                                 local:ListKeys.Target="{Binding ElementName=EnchantList}"
                                 Text="{Binding EnchantFilter, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ChooseFirstEnchantCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=EnchantList}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- A list (not just buttons) so the arrow keys in the filter can walk it; Enter takes the highlighted one. -->
                        <ListBox x:Name="EnchantList" ItemsSource="{Binding EnchantChoices}" Margin="0,0,12,0"
                                 ItemContainerStyle="{StaticResource PickItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ChooseEnchantCommand, ElementName=EnchantFilterBox}"
                                            CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" Padding="6,4" CornerRadius="3" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="11" Foreground="{StaticResource Dim}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Parchment}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Green}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Item hover card (Gear, Loot, upgrades): one shared popup that follows the mouse, closed the moment the mouse
             leaves the row. Positioned relative to the window from MainWindow.MoveItemPopup. -->
        <Popup x:Name="ItemPopup" Placement="Relative" StaysOpen="True" AllowsTransparency="True"
               IsHitTestVisible="False" Focusable="False">
            <ContentControl Content="{Binding HoverCard}" ContentTemplate="{StaticResource ItemCard}" IsHitTestVisible="False" />
        </Popup>

        <Popup x:Name="TalentPopup" Placement="Right" HorizontalOffset="8" StaysOpen="True" AllowsTransparency="True"
               IsHitTestVisible="False" Focusable="False">
            <ContentControl Content="{Binding TalentDetail}" ContentTemplate="{StaticResource TalentCard}" IsHitTestVisible="False" />
        </Popup>

        <!-- Alt-compare card: opened at the mouse while left Alt is held (MainWindow.UpdateCompare). -->
        <Popup x:Name="ComparePopup" Placement="Mouse" HorizontalOffset="18" VerticalOffset="12" StaysOpen="True"
               AllowsTransparency="True" IsHitTestVisible="False" Focusable="False">
            <Border DataContext="{Binding CompareCard}" MinWidth="230" MaxWidth="340" Padding="12,10" CornerRadius="4"
                    Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource Parchment}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Heading}" Foreground="{Binding HeadingBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,4,0,4" />
                                    <TextBlock Text="No stat changes" Foreground="{StaticResource Dim}" FontSize="12"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{Binding Brush}" FontSize="13" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- First start: the game data is being downloaded and built (MainViewModel.IsFirstLoad). -->
        <Border Grid.Row="2" Panel.ZIndex="80" Background="#B0100A06"
                Visibility="{Binding IsFirstLoad, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="26,22" CornerRadius="4"
                    Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Gold}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="The Oracle is gathering its knowledge…" FontFamily="{DynamicResource Serif}" FontSize="20"
                               Foreground="{StaticResource Gold}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="First start: the game data (items, spells, talents, maps, where things drop) is downloaded from wago.tools and put together. This takes a minute or two; after that the app starts right away."
                               FontSize="13" Foreground="{StaticResource Parchment}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,0" Foreground="{StaticResource Gold}"
                                 Background="{StaticResource Panel}" BorderThickness="0" />
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Dim}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Toast: drops in above the search bar, centred, and fades out (MainViewModel.Toast). -->
        <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0" Padding="16,8" CornerRadius="4" BorderThickness="1" IsHitTestVisible="False"
                Background="{StaticResource PanelRaised}" Opacity="0" MaxWidth="560">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="-24" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsWarning}" Value="True">
                            <Setter Property="BorderBrush" Value="#E06040" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-24" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" FontSize="14" Foreground="{StaticResource Parchment}" TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <!-- Oracle's Chronicle: what changed this session (game data, addon) and every toast (MainViewModel.Log). -->
        <Border x:Name="LogPanel" Grid.Row="2" Panel.ZIndex="90" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,2"
                Width="430" MaxHeight="340" Padding="12,10,12,10" CornerRadius="4" BorderThickness="1"
                Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Edge}"
                Visibility="{Binding IsLogOpen, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Oracle's Chronicle" FontFamily="{DynamicResource Serif}" FontSize="16"
                               Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding ToggleLogCommand}" ToolTip="Close (Esc)" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Frame" Background="Transparent" Padding="6,0">
                                    <TextBlock x:Name="Mark" Text="&#x2715;" FontSize="13" Foreground="{StaticResource Dim}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Gold}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="What changed since the app opened: game data, and what the addon brought in from the game."
                           FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Divider}" Margin="0,0,0,6" />
                <Grid>
                    <TextBlock Text="Nothing yet." FontSize="12" Foreground="{StaticResource Dim}" FontStyle="Italic"
                               Visibility="{Binding LogIsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Dim}"
                                                   Margin="0,1,8,0" Opacity="0.8" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Parchment}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="data">
                                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="addon">
                                                            <Setter Property="Foreground" Value="#8FD47A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="warn">
                                                            <Setter Property="Foreground" Value="#E06040" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="note">
                                                            <Setter Property="Opacity" Value="0.85" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="14,4,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LogButton" Command="{Binding ToggleLogCommand}" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                    ToolTip="Oracle's Chronicle: what was updated (game data, addon)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1" CornerRadius="3" Padding="7,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource Parchment}" VerticalAlignment="Center" />
                                <Border CornerRadius="7" Background="#8A2A12" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                        Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasLogNews, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LogNewCount}" FontSize="10" Foreground="{StaticResource Parchment}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Dim}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding BuildLabel}" FontSize="11" Foreground="{StaticResource Dim}" Opacity="0.7"
                           ToolTip="Free and fan-made. Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft is a trademark of Blizzard Entertainment, Inc. Game data and art from the game client via wago.tools; item sources from CMaNGOS." />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Addon" Style="{StaticResource PillButton}" Padding="8,2" Margin="0,0,8,0"
                        Command="{Binding ShowSetupPanelCommand}" ToolTip="{Binding WowFolderText}" />
                <ToggleButton Style="{StaticResource PinToggle}" IsChecked="{Binding AlwaysOnTop}" />
            </StackPanel>
        </Grid>
    </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
